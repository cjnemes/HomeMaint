# Production Environment Configuration for HomeMaint

# Application Environment
NODE_ENV=production

# Sentry Error Tracking (Optional - leave empty if not using Sentry)
# Sign up at https://sentry.io for free error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Note: Since this is a local-first app, no additional environment variables are required
# The SQLite database will be automatically created in the data/ directory
